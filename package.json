{
  "name": "sambasku-api",
  "version": "0.1.0",
  "description": "Backend API Kamus Digital Sambas-Indonesia",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "cleanup-tokens": "tsx src/scripts/cleanup-tokens.ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir '**/__tests__/unit'",
    "test:integration": "vitest run --dir '**/__tests__/integration'",
    "test:e2e": "vitest run --dir '**/__tests__/e2e'",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "rate-limiter-flexible": "^11.2.0",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
