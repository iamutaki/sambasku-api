# Copy ke .env.test (git-ignored). Harus mengarah ke DB TEST terpisah —
# JANGAN pernah pakai DATABASE_URL dev/production di sini (base-stack.md Section 10).
# Service postgres-test di docker-compose.yml jalan di port 5433.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/db_sambasku_test

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
