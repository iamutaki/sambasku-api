NODE_ENV=development
PORT=3000

# Local dev: Docker Compose service `postgres` (docker-compose.yml, port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_sambasku
# Staging/Production: Neon - pooled URL utk app, direct URL utk migrate,
# selalu ?sslmode=require (lihat base-stack.md Section 17). Diset via
# GitHub secrets, BUKAN file ini.

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Email HTTP (Resend) - dipakai LEBIH DULU daripada SMTP kalau di-set.
# Jalur utama di Cloudflare Workers (SMTP = TCP, tidak tersedia di Workers).
# MAIL_PROVIDER=resend|smtp. Kosong: Resend jika RESEND_API_KEY, else SMTP/log.
# Tanpa SMTP maupun ini: OTP/reset hanya di-log (mode dev).
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=SambasKu <no-reply@iamutaki.com>

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Image provider - dipilih lewat sini (default: imagekit, satu-satunya hari ini).
# Provider baru = impl baru + case di image-storage.factory.ts (Section 8).
IMAGE_PROVIDER=imagekit
# Kredensial PER-PROVIDER (bentuknya beda-beda, jadi memang spesifik):
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# KBBI lemma lookup (docs/api/13-api-kbbi-lemma-definition.md).
# Pola sama IMAGE_PROVIDER: pilih vendor, URL/kredensial spesifik per vendor.
KBBI_PROVIDER=raf555
# Kredensial/URL PER-PROVIDER:
RAF555_BASE_URL=https://kbbi.raf555.dev
# Matikan: KBBI_PROVIDER=none  ATAU  RAF555_BASE_URL=
LEMMA_DEFINITION_CACHE_TTL_SECONDS=3600

# Unsplash — latar kartu share kosakata (docs/backlogs/SHARE.md).
# Access Key dari https://unsplash.com/oauth/applications (Client-ID).
# Tanpa ini: GET /api/v1/share/backgrounds → items [] (mobile fallback tanpa foto).
UNSPLASH_ACCESS_KEY=
# Pexels — foto + video latar (docs/backlogs/SHARE_VIDEO.md).
# Tanpa ini: provider=pexels → items [] + degraded.
PEXELS_API_KEY=
# Pixabay — foto + video latar. Tanpa ini: provider=pixabay → items [] + degraded.
PIXABAY_API_KEY=
# Wikimedia Commons — User-Agent deskriptif (bukan rahasia). Kosong = default SambasKu.
WIKIMEDIA_USER_AGENT=
SHARE_BACKGROUNDS_CACHE_TTL_SECONDS=86400

# Firebase Cloud Messaging (opsional). Tanpa ketiganya push di-skip (no-op).
# FIREBASE_PRIVATE_KEY = PEM service account (newline sebagai \n di .env).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web OAuth client ID (publik, bukan secret). Flutter GOOGLE_WEB_CLIENT_ID
# harus SAMA. Kosong = POST /api/v1/auth/google → 503 GOOGLE_AUTH_UNAVAILABLE.
GOOGLE_CLIENT_ID=
